<div class="bg-white px-6 py-16 sm:px-8 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.link navigate={~p"/"}>
      <img class="h-10" src={~p"/images/full-logo.svg"} alt="Spendable" />
    </.link>

    <h1 class="mt-10 text-3xl font-semibold tracking-tight text-zinc-900">Almost there</h1>

    <p class="mt-8 text-base leading-7 text-zinc-700">
      Your bank has finished signing you in. Open Spendable on your phone to pick up where you
      left off - this page has nothing left to do.
    </p>
  </div>
</div>
